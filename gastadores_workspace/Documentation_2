using System;
using System.Windows.Forms;

namespace GalacticCommandCenter
{
    public partial class Form1 : Form
    {
        // ============================================================
        // PART 1: CUSTOM DELEGATE
        // ============================================================
        // Think of a delegate as a walkie-talkie.
        // It lets us call different methods using the same "channel".
        public delegate void SystemAlert(string message, int severity);

        // This is the first person who can answer the walkie-talkie.
        // It shows a message that looks like a console alert.
        private void ConsoleLog(string message, int severity)
        {
            AppendLog("[CONSOLE] Severity " + severity + ": " + message);
        }

        // This is the second person who can answer the walkie-talkie.
        // We will use both ConsoleLog and FileLog together later (multicast).
        private void FileLog(string message, int severity)
        {
            AppendLog("[LOG] Severity " + severity + ": " + message);
        }

        // ============================================================
        // PART 2: INTERFACE vs DELEGATE
        // ============================================================
        // An interface is like a job contract.
        // It says: "If you want to be upgradable, you MUST have an Upgrade method."
        public interface IUpgradable
        {
            void Upgrade();
        }

        // The Engine class signed the contract (implements the interface).
        // So it is required to have an Upgrade method.
        public class Engine : IUpgradable
        {
            public void Upgrade()
            {
                // The actual message will be shown when the button is clicked.
            }
        }

        // We create a real Engine object so we can use it.
        private Engine engine = new Engine();

        // This delegate is used for flexible calculations.
        // Unlike an interface (strict contract), a delegate is more flexible.
        public delegate int DamageCalculator(int power);

        // This method uses the delegate to calculate damage.
        // Formula: power * 2
        private int CalculateDamage(int power)
        {
            DamageCalculator calc = delegate (int p) { return p * 2; };
            return calc(power);
        }

        // ============================================================
        // PART 3 & 4: EVENT + CUSTOM EVENT ACCESSORS
        // ============================================================
        // This class manages the cargo system.
        public class CargoSystem
        {
            // This is the private storage for the event.
            private EventHandler _onCargoReceived;

            // This is the event (think of it as an alarm).
            // We added special "add" and "remove" code (custom accessors).
            public event EventHandler OnCargoReceived
            {
                // This runs when someone wants to LISTEN to the alarm.
                // It acts like a security guard checking the person first.
                add
                {
                    MessageBox.Show("Security check passed.");
                    _onCargoReceived += value;
                }

                // This runs when someone wants to STOP listening to the alarm.
                remove
                {
                    MessageBox.Show("Listener removed.");
                    _onCargoReceived -= value;
                }
            }

            // This method rings the alarm (raises the event).
            // When cargo arrives, everyone listening will be notified.
            public void ReceiveCargo()
            {
                if (_onCargoReceived != null)
                {
                    _onCargoReceived(this, EventArgs.Empty);
                }
            }
        }

        // We create a real CargoSystem object.
        private CargoSystem cargo = new CargoSystem();

        // ============================================================
        // FORM CONSTRUCTOR
        // ============================================================
        // This runs automatically when the program starts.
        public Form1()
        {
            InitializeComponent(); // Loads the buttons and textbox on the screen

            // We subscribe (start listening) to the cargo alarm.
            cargo.OnCargoReceived += CargoReceivedHandler;
        }

        // This is the method that reacts when the cargo alarm rings.
        private void CargoReceivedHandler(object sender, EventArgs e)
        {
            AppendLog("Cargo received! Processing started.");
        }

        // ============================================================
        // BUTTON CLICK EVENTS
        // ============================================================

        // Button 1: Send Console Alert
        // Only one method (ConsoleLog) is called.
        private void btnConsoleAlert_Click(object sender, EventArgs e)
        {
            SystemAlert alert = ConsoleLog;   // Give the walkie-talkie to ConsoleLog
            alert("Engine failure!", 5);      // Call it
        }

        // Button 2: Send Multicast Alert
        // Two methods are called at the same time using +=
        private void btnMulticastAlert_Click(object sender, EventArgs e)
        {
            SystemAlert alert = ConsoleLog;
            alert += FileLog;                 // Add another method (multicast)
            alert("Engine failure!", 5);      // Both methods will run
        }

        // Button 3: Upgrade Engine
        // Calls the Upgrade method through the interface contract.
        private void btnUpgradeEngine_Click(object sender, EventArgs e)
        {
            engine.Upgrade();
            AppendLog("Engine upgraded!");
        }

        // Button 4: Calculate Weapon Damage
        // Uses the flexible delegate to calculate damage.
        private void btnCalculateDamage_Click(object sender, EventArgs e)
        {
            int damage = CalculateDamage(10);
            AppendLog("Weapon Damage Calculated: " + damage);
        }

        // Button 5: Receive Cargo
        // Rings the cargo alarm so the listener can react.
        private void btnReceiveCargo_Click(object sender, EventArgs e)
        {
            cargo.ReceiveCargo();
        }

        // Button 6: Unsubscribe Listener
        // Stops listening to the cargo alarm.
        // This will also trigger the "Listener removed" message.
        private void btnUnsubscribe_Click(object sender, EventArgs e)
        {
            cargo.OnCargoReceived -= CargoReceivedHandler;
        }

        // Optional Button: Clear the log
        private void btnClearLog_Click(object sender, EventArgs e)
        {
            txtLog.Clear();
        }

        // ============================================================
        // HELPER METHOD
        // ============================================================
        // This method writes messages into the Command Log textbox.
        // We use it everywhere so we can see what the program is doing.
        private void AppendLog(string message)
        {
            txtLog.AppendText("[" + DateTime.Now.ToString("HH:mm:ss") + "] " + message + Environment.NewLine);
        }
    }
}
